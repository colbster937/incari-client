diff --git a/src/main/java/net/minecraft/client/gui/screens/WorldOptionsScreen.java b/src/main/java/net/minecraft/client/gui/screens/WorldOptionsScreen.java
index 0f277cba6561ae5b6a84218ab336b06991240ba1..0e8c6f75ff334974d119b3251067ccbbe56323e0 100644
