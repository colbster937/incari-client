@@ -637,2 +637,5 @@
                 : Component.translatable("menu.multiplayerOptions.publish.started.online");
+            // Incari start: a world in a worker is shared through a relay, not on a port (ADR 0062)
+            if (incari.client.singleplayer.WorkerWorlds.publishedMessage() != null) message = incari.client.singleplayer.WorkerWorlds.publishedMessage();
+            // Incari end
             this.sendPublishMessage(message);
