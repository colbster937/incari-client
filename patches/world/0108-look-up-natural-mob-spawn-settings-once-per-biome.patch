From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: incari-client <335801235+incari-client@users.noreply.github.com>
Date: Wed, 7 Oct 2026 14:38:11 -0400
Subject: [PATCH] world: Look up natural mob spawn settings once per biome


diff --git a/src/main/java/net/minecraft/world/level/NaturalSpawner.java b/src/main/java/net/minecraft/world/level/NaturalSpawner.java
index 64f7e8ab533442e43a05e7907d6712d28e231ca8..b5d6ffa04ebdab3a6bcace2a70ef9aed8ba2bf64 100644
--- a/src/main/java/net/minecraft/world/level/NaturalSpawner.java
+++ b/src/main/java/net/minecraft/world/level/NaturalSpawner.java
@@ -80,3 +80,5 @@
                     chunkGetter.query(ChunkPos.pack(pos), chunk -> {
-                        MobSpawnSettings naturalMobSpawns = level.environmentAttributes().getValue(EnvironmentAttributes.NATURAL_MOB_SPAWNS, pos);
+                        // Incari start: the settings looked up once per biome
+                        MobSpawnSettings naturalMobSpawns = incari.client.world.SpawnCosts.naturalMobSpawns(level, pos);
+                        // Incari end
                         MobSpawnSettings.MobSpawnCost mobSpawnCost = naturalMobSpawns.getMobSpawnCost(entity.getType());
