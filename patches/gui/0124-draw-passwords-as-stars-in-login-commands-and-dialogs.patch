From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: incari-client <335801235+incari-client@users.noreply.github.com>
Date: Fri, 9 Oct 2026 19:21:44 -0400
Subject: [PATCH] gui: Draw passwords as stars in login commands and dialogs

A login plugin's /login or /register in chat, and a server dialog's
text box labelled as a password, showed the password to anyone looking
at the screen. Incari's HiddenPasswords draws it as stars; the text
sent is unchanged.

diff --git a/src/main/java/net/minecraft/client/gui/screens/ChatScreen.java b/src/main/java/net/minecraft/client/gui/screens/ChatScreen.java
index 3922e11ac74da5c5ac357c8cccb9173b53254b5d..927c7a0dc5600ef6f255deb32e378d2f8383bf11 100644
--- a/src/main/java/net/minecraft/client/gui/screens/ChatScreen.java
+++ b/src/main/java/net/minecraft/client/gui/screens/ChatScreen.java
@@ -65,2 +65,5 @@
         this.input.setResponder(this::onEdited);
+        // Incari start: a login command's password drawn as stars
+        incari.client.gui.HiddenPasswords.hideInChat(this.input);
+        // Incari end
         this.input.addFormatter(this::formatChat);
diff --git a/src/main/java/net/minecraft/client/gui/screens/dialog/input/InputControlHandlers.java b/src/main/java/net/minecraft/client/gui/screens/dialog/input/InputControlHandlers.java
index 60b421d56f2d8ffd81a8db7b9bbc7c5cdd9ce31e..6e409a87436d8a32608423233e7351100c263016 100644
--- a/src/main/java/net/minecraft/client/gui/screens/dialog/input/InputControlHandlers.java
+++ b/src/main/java/net/minecraft/client/gui/screens/dialog/input/InputControlHandlers.java
@@ -168,2 +168,5 @@
                 EditBox editBox = new EditBox(font, input.width(), 20, input.label());
+                // Incari start: a login plugin's password box drawn as stars
+                incari.client.gui.HiddenPasswords.hideInDialog(editBox, input.label());
+                // Incari end
                 editBox.setMaxLength(input.maxLength());
