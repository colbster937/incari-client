+++ b/src/main/java/net/minecraft/client/gui/screens/ChatScreen.java
@@ -277,2 +277,5 @@
     public void extractRenderState(final GuiGraphicsExtractor graphics, final int mouseX, final int mouseY, final float a) {
+        // Incari start: the chat field as a rounded well (HudLook)
+        if (!incari.client.look.HudLook.chatField(graphics, 2, this.height - 14, this.width - 2, this.height - 2))
+        // Incari end
         graphics.fill(2, this.height - 14, this.width - 2, this.height - 2, this.minecraft.options.getBackgroundColor(Integer.MIN_VALUE));
