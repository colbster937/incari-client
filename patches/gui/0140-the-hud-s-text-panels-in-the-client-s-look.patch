+++ b/src/main/java/net/minecraft/client/gui/components/ChatComponent.java
@@ -166,3 +166,5 @@
                 int entryTop = entryBottom - entryHeight;
-                graphics.fill(-4, entryTop, maxWidth + 4 + 4, entryBottom, ARGB.black(alphax * backgroundOpacity));
+                // Incari start: chat's lines on the look's cold tint (HudLook)
+                graphics.fill(-4, entryTop, maxWidth + 4 + 4, entryBottom, incari.client.look.HudLook.chatLine(ARGB.black(alphax * backgroundOpacity)));
+                // Incari end
             });
