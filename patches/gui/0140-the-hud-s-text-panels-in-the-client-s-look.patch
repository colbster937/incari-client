diff --git a/src/main/java/net/minecraft/client/gui/Hud.java b/src/main/java/net/minecraft/client/gui/Hud.java
index 84977420997b886d87f219ccb7a1b6dbafdf76d9..92b7a563bd1b79c0d10c8ef39938c8cf58434b74 100644
--- a/src/main/java/net/minecraft/client/gui/Hud.java
+++ b/src/main/java/net/minecraft/client/gui/Hud.java
@@ -726,4 +726,10 @@
         int headerY = bottom - entriesCount * 9;
+        // Incari start: the sidebar on one glass card (HudLook)
+        if (!incari.client.look.HudLook.scoreboard(graphics, left - 2, headerY - 9 - 1, right, bottom, headerY - 1)) {
+        // Incari end
         graphics.fill(left - 2, headerY - 9 - 1, right, headerY - 1, headerBackgroundColor);
         graphics.fill(left - 2, headerY - 1, right, bottom, backgroundColor);
+        // Incari start
+        }
+        // Incari end
         graphics.text(this.getFont(), objectiveDisplayName, left + width / 2 - objectiveDisplayNameWidth / 2, headerY - 9, -1, false);
diff --git a/src/main/java/net/minecraft/client/gui/components/ChatComponent.java b/src/main/java/net/minecraft/client/gui/components/ChatComponent.java
