+++ b/src/main/java/net/minecraft/client/renderer/entity/player/AvatarRenderer.java
@@ -64,2 +64,3 @@
         this.addLayer(new BeeStingerLayer<>(this, context));
+        this.addLayer(incari.client.cosmetics.Cosmetics.layer(this)); // Incari: cosmetics (ADR 0061)
     }
@@ -187,2 +188,3 @@
         }
+        incari.client.cosmetics.Cosmetics.extract(entity, state); // Incari: cosmetics (ADR 0061)
     }
diff --git a/src/main/java/net/minecraft/client/renderer/entity/state/AvatarRenderState.java b/src/main/java/net/minecraft/client/renderer/entity/state/AvatarRenderState.java
