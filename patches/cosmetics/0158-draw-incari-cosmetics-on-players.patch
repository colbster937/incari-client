+++ b/src/main/java/net/minecraft/client/renderer/entity/state/AvatarRenderState.java
@@ -32,2 +32,3 @@
     public final ItemStackRenderState heldOnHead = new ItemStackRenderState();
+    public incari.client.cosmetics.Worn incariWorn = incari.client.cosmetics.Worn.NONE; // Incari: cosmetics (ADR 0061)
 
