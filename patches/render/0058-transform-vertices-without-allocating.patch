From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: incari-client <335801235+incari-client@users.noreply.github.com>
Date: Wed, 30 Sep 2026 11:54:44 -0400
Subject: [PATCH] render: Transform vertices without allocating


diff --git a/src/main/java/com/mojang/blaze3d/vertex/BufferBuilder.java b/src/main/java/com/mojang/blaze3d/vertex/BufferBuilder.java
index e33ea5d54bd6856ce4abf158445860d40f091e0a..b5e22d99bbcd123c671af1b6f9e7b545295b46b1 100644
--- a/src/main/java/com/mojang/blaze3d/vertex/BufferBuilder.java
+++ b/src/main/java/com/mojang/blaze3d/vertex/BufferBuilder.java
@@ -177,2 +177,14 @@
 
+    // Incari start: transform without allocating a vector per vertex (text in the world and the GUI, hot)
+    @Override
+    public VertexConsumer addVertex(final org.joml.Matrix4fc pose, final float x, final float y, final float z) {
+        return incari.client.render.VertexMath.addVertex(this, pose, x, y, z);
+    }
+
+    @Override
+    public VertexConsumer addVertexWith2DPose(final org.joml.Matrix3x2fc pose, final float x, final float y) {
+        return incari.client.render.VertexMath.addVertexWith2DPose(this, pose, x, y);
+    }
+    // Incari end
+
     @Override
