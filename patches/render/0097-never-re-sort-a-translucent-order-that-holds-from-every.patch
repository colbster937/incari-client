+++ b/src/main/java/net/minecraft/client/renderer/chunk/SectionRenderDispatcher.java
@@ -269,2 +269,5 @@
         public void resortTransparency() {
+            // Incari start: a translucent order that holds from every camera is never sorted again
+            if (incari.client.render.terrain.SectionDraws.keepsOrder(this.getSectionMesh())) return;
+            // Incari end
             if (this.getSectionMesh() instanceof CompiledSectionMesh mesh) {
