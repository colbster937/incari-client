@@ -29,3 +29,3 @@
 
-            IntArrays.mergeSort(indices, (o1, o2) -> Floats.compare(keys[o2], keys[o1]));
+            incari.client.render.QuadSort.sortDescending(keys, indices); // Incari: the same order by a radix sort (ADR 0027)
             return indices;
