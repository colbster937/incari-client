Subject: [PATCH] render: Sort translucent quads with a radix sort


diff --git a/src/main/java/com/mojang/blaze3d/vertex/VertexSorting.java b/src/main/java/com/mojang/blaze3d/vertex/VertexSorting.java
index 2af62659ba56c612455aa9c72c1d98374302542f..5f6c331bfc7c4e9fd9cb97f7c28abaf6838f9236 100644
--- a/src/main/java/com/mojang/blaze3d/vertex/VertexSorting.java
