diff --git a/src/main/java/net/minecraft/world/entity/Entity.java b/src/main/java/net/minecraft/world/entity/Entity.java
index 54c72acd71b37ae70637833a7ddb6a414d2f8885..4404c17761f3db3634e3b8c70c5ac8595c5ea7e4 100644
--- a/src/main/java/net/minecraft/world/entity/Entity.java
+++ b/src/main/java/net/minecraft/world/entity/Entity.java
@@ -1676,2 +1676,5 @@
     public void updateSwimming() {
+        // Incari start: no swimming on servers before 1.13
+        if (incari.client.legacy.LegacyPlayer.noSwimming(this)) return;
+        // Incari end
         if (this.isSwimming()) {
diff --git a/src/main/java/net/minecraft/world/entity/player/Player.java b/src/main/java/net/minecraft/world/entity/player/Player.java
