# ADRs 0052-0054: the fifteen new modules in the page. Creates a world, turns each on from the
# module menu (its search narrows the grid to the one card, whose switch is the first card's), then
# shows the HUD, the crosshair and cooldown after a swing, Freelook with Left Alt held, F2 and the
# pause menu's Screenshots button, and the gallery. No server needed. Positions are for the
# 1280x577 viewport (GUI scale 2, 640x288).
#
#   ./gradlew :app-web:browserCheck -Pbrowser.gpu=gl -Pbrowser.seconds=300 -Pbrowser.steps=@browser-checks/newmodules.steps

sleep:4000
# The first-run accessibility screen: Continue. Then Singleplayer, Create New World with the defaults.
click:0.5,0.945
sleep:3000
click:0.2,0.43
sleep:4000
click:0.38,0.945
wait:.*logged in with entity id.*
sleep:8000

