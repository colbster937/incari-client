shot:build/browser-checks/newmodules-pause.png
until:window.incariStorage.pending() === 0
assert:(async () => { let d = await navigator.storage.getDirectory(); for (const p of ["incari", "game", "screenshots"]) d = await d.getDirectoryHandle(p); let count = 0; for await (const [name] of d.entries()) { if (name.endsWith(".png")) count++; } console.log("[check] screenshots: " + count); return count > 0; })()
